{
  "name": "vocabulary-api",
  "version": "1.0.0",
  "private": true,
  "description": "Small vocabulary API deployed for the infrastructure course.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
